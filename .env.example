# Copie para .env.local e ajuste.
# NUNCA coloque chaves de API aqui: tudo com prefixo VITE_ vai para o navegador.
# Chaves do LLM ficam só no back.

# "false" chama o back real. Qualquer outro valor (ou ausente) usa o mock.
VITE_USE_MOCK=true

# URL base do back em produção. Vazio = mesma origem (/api).
VITE_API_BASE_URL=

# Destino do proxy /api no `npm run dev` (não vai para o navegador).
API_PROXY_TARGET=http://localhost:3000
